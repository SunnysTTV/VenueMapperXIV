<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.6.0</Version>
    <AssemblyName>VenueMapper</AssemblyName>
    <RootNamespace>VenueMapper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>bin\dev\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\venues.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" Condition="Exists('images\icon.png')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pictomancy" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>
</Project>
